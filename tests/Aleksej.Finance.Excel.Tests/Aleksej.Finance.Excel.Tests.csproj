<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Must match the add-in: net48 + x64, and 64-bit Excel. -->
    <TargetFramework>net48</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Aleksej.Finance.Excel.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- ExcelDNA's integration-test harness (pinned to match the add-in's embedded 1.9.0).
         It depends on xunit 2.4.1, so the xunit packages are pinned to that line. -->
    <PackageReference Include="ExcelDna.Testing" Version="1.9.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.4.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.3" />
    <!-- net48 reference assemblies so no targeting pack is required (mirrors the add-in). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Required for the `dynamic` COM automation in SheetHarness. -->
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build the add-in (and its packed .xll) first; do NOT copy its assembly into the
         test bin (the add-in loads as an .xll, not as a referenced assembly). -->
    <ProjectReference Include="..\..\Aleksej.Finance.Excel.csproj">
      <Private>false</Private>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <!-- Copy the single self-contained add-in next to the test assembly so the harness can
       load it by filename (see ExcelTestSettings.cs). -->
  <Target Name="CopyAddInXll" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\bin\x64\$(Configuration)\net48\Aleksej.Finance.ExcelAddin.xll"
          DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\bin\x64\$(Configuration)\net48\Aleksej.Finance.ExcelAddin.xll')" />
  </Target>

</Project>
